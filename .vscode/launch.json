{
  "version": "0.2.0",
  "configurations": [
     {
      "name": "Debug MCP client",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/client.py",
      "cwd": "${workspaceFolder}",            
      "console": "integratedTerminal"
    },
    {
      "name": "Run MCP client with argument",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/client.py",
      "args": ["Hi, give me top 5 employee"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/app/.env"
    },
    {
    "name": "Run FastMCP (http)",
    "type": "python",
    "request": "launch",
    "module": "app.run_mcp",
    "console": "integratedTerminal",
    "justMyCode": false
   }
  ]
}