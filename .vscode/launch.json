{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug MCP client",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/client.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run FastMCP Server (HTTP)",
      "type": "python",
      "request": "launch",
      "module": "app.run_mcp",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run FastMCP Server (stdio)",
      "type": "python",
      "request": "launch",
      "module": "app.run_mcp",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "MCP_TRANSPORT": "stdio"
      }
    }
  ]
}