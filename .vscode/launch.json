{
  "version": "0.2.0",
  "configurations": [
  {
    "name": "Run dbwhisper Server",
    "type": "debugpy",
    "request": "launch",
    "module": "app.run_mcp",
    "cwd": "${workspaceFolder}",
    "console": "integratedTerminal",
    "justMyCode": false,
    "envFile": "${workspaceFolder}/.env"
  },
    {
      "name": "Debug Tools",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/tools.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}